<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- פיץ׳ מריץ osascript כדי להקפיץ חלון־מסוף לחזית. תחת זמן־ריצה
         מוקשח, האחריות על אירוע־האפל מיוחסת לפיץ׳ ולא לתהליך־הבן,
         ובלי ההרשאה הזאת הקפיצה נכשלת בשקט. -->
    <key>com.apple.security.automation.apple-events</key>
    <true/>
</dict>
</plist>
